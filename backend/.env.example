# ===== 服务 =====
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# ===== 数据库 =====
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== 认证 =====
JWT_SECRET=change-me-dev
JWT_EXPIRE_MINUTES=1440

# ===== 文件 / 向量 =====
UPLOAD_DIR=./data/uploads
VECTOR_INDEX_DIR=./data/faiss

# ===== 对话参数 =====
QA_SIMILARITY_THRESHOLD=0.45
SHORT_MEMORY_TURNS=3
INTENT_CONFIDENCE_THRESHOLD=0.7

# ===== LLM（阿里云百炼 OpenAI 兼容）=====
# 控制台创建 API Key：https://bailian.console.aliyun.com/
# 填入后重启后端；未配置时对话自动降级为知识模板回答
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_EMBEDDING=text-embedding-v3
LLM_MODEL_INTENT=qwen-turbo
LLM_MODEL_GENERATE=qwen-plus
LLM_MODEL_RERANK=

# ===== 演示数据 =====
SEED_DEMO_USERS=true
